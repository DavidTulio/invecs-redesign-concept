# Copy to .env.local and fill in. Never commit .env.local.
# Supabase: Dashboard → Project Settings → API Keys (and the "Connect" button for the URL).

# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only (never prefix with NEXT_PUBLIC_, never paste in chat)
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
